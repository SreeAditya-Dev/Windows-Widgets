{
  "name": "mac-widgets-windows",
  "version": "2.1.0",
  "description": "macOS-style desktop widgets for Windows",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "keywords": [
    "widgets",
    "macos",
    "windows",
    "desktop-widgets"
  ],
  "author": "SreeAditya",
  "license": "MIT",
  "dependencies": {
    "koffi": "^2.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^1.16.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "zustand": "^4.5.5"
  },
  "productName": "Desktop Widgets",
  "build": {
    "appId": "com.sreeaditya.desktopwidgets",
    "productName": "Desktop Widgets",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desktop Widgets",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Desktop-Widgets-Setup-${version}.${ext}"
    }
  }
}
